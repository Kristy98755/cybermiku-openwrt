#!/bin/sh

# Set default hostname
uci set system.@system[0].hostname='cybermiku'

# Enable WiFi by default
uci set wireless.radio0.disabled='0'

# Set default WiFi SSID
uci set wireless.default_radio0.ssid='Miku Hiding in Your Wi-Fi'

# Open network by default so users can connect over the air before setup
uci set wireless.default_radio0.encryption='none'
uci set wireless.default_radio0.key=''

# Set timezone to Moscow
uci set system.@system[0].timezone='MSK-3'

# NOTE: do not touch uhttpd.main.lua_prefix - on OpenWrt 21.02 the Lua SGI
# (option lua_prefix '/cgi-bin/luci') IS the dispatcher; removing it would
# break /cgi-bin/luci entirely.

# Steady LEDs (no activity blinking):
# - wlan: phy0tpt blinks on any wifi packet (broadcast noise at idle);
#   netdev link = solid while radio is on
# - lan/wan: switch trigger defaults to link+tx+rx = blinks on port traffic;
#   mode link = solid while cable is connected
uci set system.led_wlan2g.trigger='netdev'
uci set system.led_wlan2g.dev='wlan0'
uci set system.led_wlan2g.mode='link'
uci set system.led_lan.mode='link'
uci set system.led_wan.mode='link'

# Save changes
uci commit

echo "CyberMiku initial configuration applied."
