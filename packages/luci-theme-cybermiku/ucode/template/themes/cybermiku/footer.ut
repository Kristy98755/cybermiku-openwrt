		{% if (!blank_page): %}
		</div>
		<footer>
			<span style="color:#008b8b;font-size:0.7rem;letter-spacing:2px;">
				CYBERMIKU // Powered by
				<a href="https://github.com/openwrt/luci" target="_blank" style="color:#39c5bb;">{{ version.luciname }}</a>
				/
				<a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" style="color:#39c5bb;">{{ version.distname }} {{ version.distversion }}</a>
			</span>
			<ul class="breadcrumb pull-right" id="modemenu" style="display:none"></ul>
		</footer>
		<script>L.require('menu-bootstrap')</script>
		{% endif %}
	</body>
</html>
