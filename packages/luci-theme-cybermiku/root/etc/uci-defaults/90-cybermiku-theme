#!/bin/sh

uci set luci.main.mediatheme='cybermiku'
uci set luci.main.mediaurlbase='/luci-static/cybermiku'

uci -q batch <<-EOT
	delete luci.themes.CyberMiku
	set luci.themes.CyberMiku='/luci-static/cybermiku'
EOT

uci commit luci

# Serve the CyberMiku dashboard from http://192.168.1.1 while keeping the
# stock LuCI reachable directly at /cgi-bin/luci/.
if [ -f /www/cybermiku-index.html ]; then
	cp /www/cybermiku-index.html /www/index.html
fi

echo "CyberMiku theme activated."
